# Imolites in Diaspora Social Club USA
# Apache Configuration for Hostinger & cPanel

DirectoryIndex index.php index.html

# MIME Types for Audio, Video, and Modern Image Formats
<IfModule mod_mime.c>
    AddType audio/mpeg .mp3
    AddType video/mp4 .mp4
    AddType image/webp .webp
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
</IfModule>

# Byte range requests for smooth mobile audio streaming (iOS Safari & Android)
<IfModule mod_headers.c>
    <FilesMatch "\.(mp3|mp4)$">
        Header set Accept-Ranges bytes
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect .html requests to .php if running in Apache PHP environment
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)\.html$ $1.php [L,QSA]

    # Clean URL support: /about -> about.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# Caching and Cache-Busting for Hostinger & Cloudflare
<IfModule mod_headers.c>
    # Immediately revalidate HTML and PHP dynamic files
    <FilesMatch "\.(php|html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Hostinger LiteSpeed Cache Directives
<IfModule LiteSpeed>
    CacheLookup on
    CacheEngine off
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType audio/mpeg "access plus 1 month"
</IfModule>
